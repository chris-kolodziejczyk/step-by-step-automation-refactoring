{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["checkpoints", "node_modules", "evidence", "archive"]
}
